# Ladica Sync — frontend environment
#
# Base URL of the Ladica Sync backend (the linker-be service). Sync is optional:
# the app works fully offline and signed-out even if this points nowhere.
PUBLIC_API_BASE=https://ladica-api.hrva.cc

# For local development against a backend running on your machine, use:
# PUBLIC_API_BASE=http://localhost:8080
