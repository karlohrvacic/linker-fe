---
// The Ladica chain logo. Sized via the `size` prop; color follows currentColor.
interface Props { size?: number; }
const { size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M9.5 14.5l5-5" />
  <path d="M7.5 10.5l-2 2a3.5 3.5 0 0 0 5 5l2-2" />
  <path d="M16.5 13.5l2-2a3.5 3.5 0 0 0-5-5l-2 2" />
</svg>
