---
import { tt, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Within-locale URL of this page in Croatian (unprefixed). */
  hrHref: string;
  /** Within-locale URL of this page in English (/en-prefixed). */
  enHref: string;
}

const { lang, hrHref, enHref } = Astro.props;
---

<div class="langswitch" role="group" aria-label={tt(lang, 'lang.switchAria')}>
  <a
    class:list={['seg', { on: lang === 'hr' }]}
    href={hrHref}
    data-lang="hr"
    aria-current={lang === 'hr' ? 'true' : undefined}
    aria-label={tt(lang, 'lang.toHrAria')}>{tt(lang, 'lang.hr')}</a>
  <a
    class:list={['seg', { on: lang === 'en' }]}
    href={enHref}
    data-lang="en"
    aria-current={lang === 'en' ? 'true' : undefined}
    aria-label={tt(lang, 'lang.toEnAria')}>{tt(lang, 'lang.en')}</a>
</div>

<script>
  // Persist the chosen language to the same key the app uses, then let the
  // <a href> carry the navigation to the matching locale URL.
  for (const el of document.querySelectorAll<HTMLAnchorElement>('.langswitch a[data-lang]')) {
    el.addEventListener('click', () => {
      try {
        localStorage.setItem('ladica-lang', el.dataset.lang || 'hr');
      } catch (e) {
        /* storage unavailable — navigation still proceeds */
      }
    });
  }
</script>

<style>
  .langswitch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }
  .seg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 30px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: var(--w-bold);
    letter-spacing: 0.02em;
    color: var(--muted);
    transition: background 0.15s, color 0.15s;
  }
  .seg.on {
    background: var(--soft);
    color: var(--accent-dk);
  }
  .seg:not(.on):hover {
    color: var(--fg);
  }
  .seg:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .seg {
      transition: none;
    }
  }
</style>
